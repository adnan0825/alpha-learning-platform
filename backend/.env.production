NODE_ENV=production
HOST=0.0.0.0
PORT=10000

# Required production secrets
JWT_SECRET=replace-with-32-plus-character-secret
DATABASE_URL=postgresql://user:password@host:5432/alpha
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional admin bootstrapping for first sign-in
# GOOGLE_BOOTSTRAP_ADMIN_EMAIL=you@gmail.com

# Public API origin used for generated URLs and uploads
PUBLIC_BASE_URL=https://api.alpha.online
CORS_ORIGINS=https://alpha.online,https://www.alpha.online

# Cloudflare R2 storage (required for production uploads)
R2_ENDPOINT=https://ab7f3fc168f88a27dd6ca11764b7038d.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=1f56665a28c34afd97ec8c341935d684
R2_SECRET_ACCESS_KEY=f2c88e4993ca445bd6c4646de2637de62485620174d8672d71e6885bbe758e16
R2_BUCKET=alpha-learning-platform-media
R2_PUBLIC_URL=https://media.alpha.online

# Optional tuning
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
