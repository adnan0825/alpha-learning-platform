# Copy to .env and fill in values

PORT=3000
JWT_SECRET=change-me-in-production

# Database - PostgreSQL (local or remote)
#
# Option A - single URL (overrides DB_*):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/alpha
#
# Option B - separate vars (see backend/src/config/db.ts):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=alpha
DB_PASSWORD=alpha_password
DB_NAME=alpha
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: comma-separated extra CORS origins
# CORS_ORIGINS=https://staging.alpha.online

# Email/password API (/auth/login, /register) - disabled by default. Set to 'true' only for local testing.
# AUTH_ALLOW_PASSWORD_LOGIN=true

# Google Sign-In - same Web client ID as frontend VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Required for redirect sign-in (authorization code exchange).
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: this Google account always gets role `admin` on sign-in (create or upgrade). Remove when no longer needed.
# GOOGLE_BOOTSTRAP_ADMIN_EMAIL=you@gmail.com
