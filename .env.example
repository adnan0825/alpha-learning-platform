# ============================================================
# Alpha Backend Configuration
# Copy this file to .env and configure for your environment
# ============================================================

# PostgreSQL Database Configuration
# Supports both individual connection parameters and connection string.
# Individual parameters take precedence over DATABASE_URL.

## Option A: Individual connection parameters (recommended for local development)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=alpha
DB_PASSWORD=alpha_password
DB_NAME=alpha

## Option B: PostgreSQL connection string (for managed services like Neon, RDS)
## If DATABASE_URL is set, it takes precedence over individual parameters above.
# DATABASE_URL=postgresql://postgres:password@host:5432/alpha

## SSL configuration (required for managed PostgreSQL services)
## Set to 'true' for services like Neon, RDS, or other cloud PostgreSQL
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Application Server
NODE_ENV=development
PORT=5000

# JWT Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_required_change_this_value

# Google OAuth (optional, required for Google Sign-In feature)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Email Configuration (optional, for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Upload Directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Chapa Payment Gateway (optional)
CHAPA_API_KEY=your-chapa-api-key
CHAPA_SECRET_KEY=your-chapa-secret-key

