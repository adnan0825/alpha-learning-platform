# API base path. Default is `/api` (same origin).
# - Local dev: Vite proxies `/api` → http://127.0.0.1:3000 (run the backend). No CORS.
# - Production: set the real API origin so the browser calls the deployed backend directly.
#   Example: VITE_API_URL=https://api.alpha.online/api
# VITE_API_URL=/api
#
# Dev-only proxy target (default http://127.0.0.1:3000)
# VITE_PROXY_API_TARGET=https://api.alpha.online

# Google Sign-In — same Web client ID as backend GOOGLE_CLIENT_ID (not the secret).
# In Google Cloud Console → OAuth Web client → Authorized JavaScript origins, add your exact origins, e.g.:
#   http://localhost:8080   http://127.0.0.1:8080   https://alpha.online   https://www.alpha.online
# (This project uses Vite port 8080, not 5173.)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
