# Used automatically by `vite build` / `npm run build` (production bundle).
# Copy to `.env.production` on the build machine and set your OAuth **Web client ID**
# (same value as backend GOOGLE_CLIENT_ID — public, not a secret).
#
#   cp .env.production.example .env.production
#   nano .env.production
#
# Without VITE_GOOGLE_CLIENT_ID, the login page cannot show "Continue with Google".

VITE_API_URL=https://api.alpha.online/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
